<UserControl x:Class="LocalXI.App.Views.SavesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Saves &amp; backups" Style="{StaticResource PageTitle}" />

            <Border Style="{StaticResource Card}" Visibility="{Binding IsJoin, Converter={StaticResource BoolToVisibility}}">
                <TextBlock TextWrapping="Wrap"
                           Text="While you are joining a friend, your characters are stored on their PC. Ask your host to export a save if you want to take your characters with you." />
            </Border>

            <StackPanel Visibility="{Binding IsJoin, Converter={StaticResource InverseBoolToVisibility}}">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Characters on this PC" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding CharactersNote}" Style="{StaticResource Hint}"
                                   Visibility="{Binding CharactersNote, Converter={StaticResource NullToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding Characters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding Job}" />
                                        <TextBlock Grid.Column="2" Foreground="{StaticResource SubtleTextBrush}">
                                            <Run Text="account" />
                                            <Run Text="{Binding Account, Mode=OneWay}" />
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Take your characters to another PC" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Export makes one .xisave file holding every character on this PC: levels, jobs, items, Mog House, quests, missions and story progress. Copy it to the other PC (USB stick, cloud drive, Discord...) and press Import there." />
                        <WrapPanel Margin="0,6,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Content="Export save..." Command="{Binding ExportCommand}" Margin="0,0,10,8" />
                            <Button Content="Import save..." Command="{Binding ImportFromFileCommand}" Margin="0,0,10,8" />
                            <Button Content="Back up now" Command="{Binding BackupNowCommand}" Margin="0,0,10,8" />
                            <Button Content="Open saves folder" Command="{Binding OpenSavesFolderCommand}" Margin="0,0,10,8" />
                            <Button Content="Open backups folder" Command="{Binding OpenBackupsFolderCommand}" Margin="0,0,10,8" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Refresh" Command="{Binding RefreshFilesCommand}" Margin="0,0,10,0" />
                                <Button Content="Load selected" Command="{Binding ImportSelectedCommand}" Margin="0" />
                            </StackPanel>
                            <TextBlock Text="Save files" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0" />
                        </DockPanel>
                        <ListView ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" MaxHeight="340">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Type" DisplayMemberBinding="{Binding Kind}" Width="80" />
                                    <GridViewColumn Header="Date" DisplayMemberBinding="{Binding Date}" Width="150" />
                                    <GridViewColumn Header="Characters" DisplayMemberBinding="{Binding Characters}" Width="300" />
                                    <GridViewColumn Header="Size" DisplayMemberBinding="{Binding Size}" Width="80" />
                                    <GridViewColumn Header="File" DisplayMemberBinding="{Binding Name}" Width="260" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                   Text="Backups are made automatically when the server stops. Loading a save replaces the characters on this PC, after backing them up first." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
