<UserControl x:Class="LocalXI.App.Views.PlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Play" Style="{StaticResource PageTitle}" />

            <ItemsControl ItemsSource="{Binding Warnings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#2A2416" BorderBrush="{StaticResource WarnBrush}" BorderThickness="1" CornerRadius="6" Padding="12,9" Margin="0,0,0,10">
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Card}" Padding="26,22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Ready when you are" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Hint}">
                            <Run Text="Logging in as" />
                            <Run Text="{Binding AccountName, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Hint}" Visibility="{Binding IsJoin, Converter={StaticResource BoolToVisibility}}">
                            <Run Text="Connecting to your friend at" />
                            <Run Text="{Binding JoinAddress, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Hint}" Text="The game is running." Foreground="{StaticResource GoodBrush}"
                                   Visibility="{Binding IsGameRunning, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource PlayButton}" Content="Play" Command="{Binding PlayCommand}" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Visibility="{Binding IsHost, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Friends join with this address" Style="{StaticResource SectionTitle}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox Text="{Binding HostAddress, Mode=OneWay}" IsReadOnly="True" FontSize="20" MinWidth="230" />
                        <Button Content="Copy" Command="{Binding CopyHostAddressCommand}" Margin="10,0,0,0" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                               Text="In LocalXI your friend chooses &quot;Join a friend&quot; and enters this address. If you use Radmin VPN, both of you must be connected to the same Radmin network. The server keeps running while friends are online, even after you close your game." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Visibility="{Binding ShowServer, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="Stop server" Command="{Binding StopServerCommand}" Margin="0"
                                Visibility="{Binding IsServerRunning, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="Server" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding ServerProcesses}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#151C25" CornerRadius="6" Padding="12,8" Margin="0,0,10,10" MinWidth="130">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="10" Height="10" Fill="{Binding State, Converter={StaticResource ProcessStateBrush}}" Margin="0,0,8,0" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Description}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding State}" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="The server starts when you press Play and stops (with an automatic backup) when you close the game." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
