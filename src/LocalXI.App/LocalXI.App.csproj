<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>LocalXI.App</RootNamespace>
    <AssemblyName>LocalXI</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Drawn by tools\make-icon.ps1. -->
    <ApplicationIcon>Assets\LocalXI.ico</ApplicationIcon>
    <!-- WPF0001: the Fluent ThemeMode API is still marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\LocalXI.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LocalXI.Core\LocalXI.Core.csproj" />
  </ItemGroup>

</Project>
