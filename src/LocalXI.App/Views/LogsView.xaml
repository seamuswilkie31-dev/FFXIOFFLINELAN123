<UserControl x:Class="LocalXI.App.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Logs" Style="{StaticResource PageTitle}" />
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" MinWidth="180" />
            <Button Content="Clear" Command="{Binding ClearCommand}" Margin="10,0,0,0" />
            <Button Content="Open logs folder" Command="{Binding OpenLogsFolderCommand}" Margin="10,0,0,0" />
        </StackPanel>
        <TextBox x:Name="Output" Style="{StaticResource LogBox}" Text="{Binding Text, Mode=OneWay}" />
    </DockPanel>
</UserControl>
