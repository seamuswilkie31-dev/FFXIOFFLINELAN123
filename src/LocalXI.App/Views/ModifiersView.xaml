<UserControl x:Class="LocalXI.App.Views.ModifiersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Modifiers" Style="{StaticResource PageTitle}" Margin="0,0,0,10" />

        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Visibility="{Binding CanEdit, Converter={StaticResource InverseBoolToVisibility}}">
            <TextBlock TextWrapping="Wrap" Text="Modifiers edit the characters on your own world. While you're joining a friend, your characters live on their PC." />
        </Border>

        <StackPanel DockPanel.Dock="Top" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}">
            <Border Background="#2A2416" BorderBrush="{StaticResource WarnBrush}" BorderThickness="1" CornerRadius="6" Padding="12,9" Margin="0,0,0,10"
                    Visibility="{Binding ServerRunning, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Stop server" Command="{Binding StopServerCommand}" Margin="10,0,0,0" />
                    <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
                               Text="The server is running. You can look around, but saving changes needs it stopped: the game keeps characters in memory and would write over them." />
                </DockPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="16,12">
                <WrapPanel>
                    <StackPanel Margin="0,0,24,4">
                        <TextBlock Text="Character" Style="{StaticResource Hint}" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal">
                            <ComboBox ItemsSource="{Binding Characters}" SelectedItem="{Binding SelectedCharacter}" DisplayMemberPath="Label" MinWidth="300" />
                            <Button Content="Refresh" Command="{Binding LoadCharactersCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,4">
                        <TextBlock Text="EXP rate (whole world)" Style="{StaticResource Hint}" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal">
                            <ComboBox ItemsSource="{Binding ExpRates}" SelectedItem="{Binding ExpRate}" Width="100">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat='x{0}'}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Content="Set" Command="{Binding SaveExpRateCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </WrapPanel>
            </Border>
            <TextBlock Text="{Binding LoadNote}" Style="{StaticResource Hint}" Visibility="{Binding LoadNote, Converter={StaticResource NullToVisibility}}" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                       Text="Everything is backed up automatically before the first change each session (Saves page). LandSandBoat's EXP rate covers the whole world, not one character." />
        </StackPanel>

        <TabControl Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}">
            <TabItem Header="Inventory">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,12,4,4">
                        <TextBlock Text="Gil" Style="{StaticResource SectionTitle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBox Text="{Binding Gil, UpdateSourceTrigger=PropertyChanged}" Width="180" />
                            <Button Content="Set gil" Command="{Binding SetGilCommand}" Margin="8,0,0,0" />
                        </StackPanel>

                        <TextBlock Text="Add an item" Style="{StaticResource SectionTitle}" />
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="Search" Command="{Binding SearchItemsCommand}" Margin="8,0,0,0" IsDefault="True" />
                            <TextBox Text="{Binding ItemSearch, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <ListView ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedSearchResult}" Height="190">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Item" DisplayMemberBinding="{Binding Name}" Width="320" />
                                    <GridViewColumn Header="Stack" DisplayMemberBinding="{Binding StackSize}" Width="70" />
                                    <GridViewColumn Header="Rare" DisplayMemberBinding="{Binding Rare}" Width="70" />
                                    <GridViewColumn Header="Ex" DisplayMemberBinding="{Binding Ex}" Width="70" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,14">
                            <TextBlock Text="Quantity" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Text="{Binding AddQuantity, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                            <Button Style="{StaticResource PrimaryButton}" Content="Add to inventory" Command="{Binding AddItemCommand}" Margin="10,0,0,0" Padding="16,7" />
                        </StackPanel>

                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Remove selected" Command="{Binding RemoveItemCommand}" />
                            <TextBlock Text="Inventory" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0" />
                        </DockPanel>
                        <TextBlock Text="{Binding InventorySummary}" Style="{StaticResource Hint}" />
                        <ListView ItemsSource="{Binding Inventory}" SelectedItem="{Binding SelectedInventoryItem}" Height="220">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Slot" DisplayMemberBinding="{Binding Slot}" Width="60" />
                                    <GridViewColumn Header="Item" DisplayMemberBinding="{Binding Name}" Width="320" />
                                    <GridViewColumn Header="Qty" DisplayMemberBinding="{Binding Quantity}" Width="70" />
                                    <GridViewColumn Header="Equipped" DisplayMemberBinding="{Binding Equipped}" Width="90" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Jobs">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,12,4,4">
                        <TextBlock Text="{Binding LevelHint}" Style="{StaticResource Hint}" />
                        <ItemsControl ItemsSource="{Binding JobRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2" IsEnabled="{Binding Available}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                        <CheckBox Grid.Column="1" Content="Unlocked" IsChecked="{Binding Unlocked}" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <TextBlock Text="Level" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBox Text="{Binding Level, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource PrimaryButton}" Content="Save jobs" Command="{Binding SaveJobsCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                   Text="Changing a job's level resets its EXP toward the next level. The level cap from limit-break quests is raised if needed so the new levels stick." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Fame">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,12,4,4">
                        <ItemsControl ItemsSource="{Binding FameRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="Fame level" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <ComboBox ItemsSource="{Binding DataContext.FameLevels, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedItem="{Binding Level}" Width="80" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding DerivedFame}" Style="{StaticResource Hint}" Margin="0,10,0,0" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Save fame" Command="{Binding SaveFameCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Quests">
                <DockPanel Margin="4,12,4,4">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <ComboBox ItemsSource="{Binding QuestAreas}" SelectedIndex="{Binding SelectedQuestArea}" Width="180" />
                        <TextBox Text="{Binding QuestFilter, UpdateSourceTrigger=PropertyChanged}" Width="240" Margin="10,0,0,0" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Save quest changes" Command="{Binding SaveQuestsCommand}" Margin="10,0,0,0" Padding="16,7" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding QuestSummary}" Style="{StaticResource Hint}" />
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="0,8,0,0"
                               Text="This changes the quest log only: rewards aren't handed out. Resetting or completing a quest also clears its in-progress steps, as the game does." />
                    <ListView ItemsSource="{Binding Quests}" MinHeight="260">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Quest" DisplayMemberBinding="{Binding Name}" Width="380" />
                                <GridViewColumn Header="State" Width="180">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.QuestStates, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedItem="{Binding State}" Width="150">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>

            <TabItem Header="Home points">
                <StackPanel Margin="4,12,4,4">
                    <TextBlock Text="{Binding HomePointSummary}" FontSize="15" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButton}" Content="Register every home point" Command="{Binding RegisterAllHomePointsCommand}" />
                        <Button Content="Clear all" Command="{Binding ClearHomePointsCommand}" Margin="10,0,0,0" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                               Text="Registers every home point crystal so you can warp between them from any crystal, without touching each one first. Uses the same records the game writes when you touch a crystal." />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
