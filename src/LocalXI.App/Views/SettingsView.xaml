<UserControl x:Class="LocalXI.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <DockPanel Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Save settings" Command="{Binding SaveCommand}" VerticalAlignment="Center" />
                <TextBlock Text="Settings" Style="{StaticResource PageTitle}" Margin="0" />
            </DockPanel>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Game folder" Style="{StaticResource SectionTitle}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Browse..." Command="{Binding BrowseGameFolderCommand}" Margin="10,0,0,0" />
                        <TextBox Text="{Binding FfxiPath, UpdateSourceTrigger=LostFocus}" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding GameChecks}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,2" TextWrapping="Wrap">
                                    <Run Text="{Binding Passed, Mode=OneWay, Converter={StaticResource CheckMark}}" Foreground="{Binding Passed, Converter={StaticResource CheckBrush}}" FontWeight="Bold" />
                                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text="-" Foreground="{StaticResource SubtleTextBrush}" />
                                    <Run Text="{Binding Detail, Mode=OneWay}" Foreground="{StaticResource SubtleTextBrush}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding RegistryStatus}" TextWrapping="Wrap" Margin="0,10,0,6" />
                    <Button Content="Fix registry" Command="{Binding FixRegistryCommand}" HorizontalAlignment="Left"
                            Visibility="{Binding RegistryOk, Converter={StaticResource InverseBoolToVisibility}}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Display" Style="{StaticResource SectionTitle}" />
                    <WrapPanel>
                        <StackPanel Margin="0,0,14,8">
                            <TextBlock Text="Width" Style="{StaticResource Hint}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Width}" Width="100" />
                        </StackPanel>
                        <StackPanel Margin="0,0,14,8">
                            <TextBlock Text="Height" Style="{StaticResource Hint}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Height}" Width="100" />
                        </StackPanel>
                        <StackPanel Margin="0,0,14,8">
                            <TextBlock Text="Window" Style="{StaticResource Hint}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding WindowModes}" SelectedItem="{Binding WindowMode}" Width="220">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Visibility="{Binding RunsLocalServer, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Server" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Game era" Style="{StaticResource Hint}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Eras}" SelectedItem="{Binding Era}" Width="380" HorizontalAlignment="Left">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EraDisplay}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,12"
                               Text="Classic plays like the level-75 days: Zilart, Promathia, Aht Urhgan and Wings of the Goddess, with old-style rules. Modern is today's game. Switching reloads the game data the next time you press Play; characters are kept and backed up first." />
                    <CheckBox Content="Modern era: load zones on demand (faster start, less memory)" IsChecked="{Binding LazyZones}" Margin="0,0,0,2" />
                    <TextBlock Style="{StaticResource Hint}" Margin="28,0,0,8"
                               Text="Classic always loads every zone at start-up, because many classic rules live in zone scripts." />
                    <CheckBox Content="Stop the server when I close the game (it keeps running while friends are online)" IsChecked="{Binding StopWhenGameCloses}" Margin="0,0,0,6" />
                    <CheckBox Content="Allow older game versions to log in (may cause visual glitches)" IsChecked="{Binding AllowOlderClients}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Visibility="{Binding RunsLocalServer, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Backups" Style="{StaticResource SectionTitle}" />
                    <CheckBox Content="Back up characters automatically when the server stops" IsChecked="{Binding BackupOnGameExit}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Keep the newest" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Text="{Binding BackupsToKeep}" Width="70" />
                        <TextBlock Text="automatic backups" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Account" Style="{StaticResource SectionTitle}" />
                    <TextBlock Margin="0,0,0,8">
                        <Run Text="Logged in as" Foreground="{StaticResource SubtleTextBrush}" />
                        <Run Text="{Binding Username, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" Width="220" />
                        <Button Content="Change password" Command="{Binding ChangePasswordCommand}" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Setup &amp; folders" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Hint}">
                        <Run Text="Launcher data:" />
                        <Run Text="{Binding DataFolder, Mode=OneWay}" />
                        <LineBreak />
                        <Run Text="Saves, backups and screenshots:" />
                        <Run Text="{Binding UserFolder, Mode=OneWay}" />
                    </TextBlock>
                    <WrapPanel>
                        <Button Content="Run setup again" Command="{Binding RerunSetupCommand}" Margin="0,0,10,8" />
                        <Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}" Margin="0,0,10,8" />
                        <Button Content="Open saves folder" Command="{Binding OpenUserFolderCommand}" Margin="0,0,10,8" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Expander Header="Developer options" Margin="0,0,0,14">
                <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="Use a local LandSandBoat build" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Point this at a LandSandBoat folder you built yourself (it must contain xi_map.exe, sql and scripts). Leave empty to use the downloaded server." />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Browse..." Command="{Binding BrowseOverrideCommand}" Margin="10,0,0,0" />
                            <TextBox Text="{Binding OverrideDirectory}" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Expander>

            <TextBlock Text="{Binding Version}" Style="{StaticResource Hint}" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="LocalXI uses LandSandBoat (GPL-3.0), Ashita (GPL-3.0), xiloader (GPL-3.0) and MariaDB (GPL-2.0). FINAL FANTASY is a registered trademark of Square Enix. LocalXI is not affiliated with or endorsed by Square Enix, and includes none of its game files." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
